{# https://shopify.dev/docs/api/admin-graphql/latest/mutations/collectionCreate #}
mutation {
  collectionCreate(input: {
    title:  {{ title|json_encode|raw }},
    handle: {{ handle|json_encode|raw }}
    {#- templateSuffix (native theme template): a SCALAR CollectionInput field, so keyed on PRESENCE — a caller that
        passes it asserts the template ('' = the theme's default template, which also clears a hand-set suffix);
        callers that omit the key let Shopify apply the theme default. Same convention as productSet. #}
    {%- if templateSuffix is defined and templateSuffix is not null -%}
    ,
    templateSuffix: {{ templateSuffix|json_encode|raw }}
    {%- endif -%}
    {%- if ruleSet is defined and ruleSet -%}
    ,
    ruleSet: {
      appliedDisjunctively: {{ ruleSet.appliedDisjunctively|default(false) ? 'true' : 'false' }},
      rules: [
        {%- for r in ruleSet.rules %}
        { column: {{ r.column }}, relation: {{ r.relation }}, condition: {{ r.condition|json_encode|raw }}{% if r.conditionObjectId is defined and r.conditionObjectId %}, conditionObjectId: {{ r.conditionObjectId|json_encode|raw }}{% endif %} }{% if not loop.last %},{% endif %}
        {%- endfor %}
      ]
    }
    {%- endif -%}
    {%- if metafields is defined and metafields|length > 0 -%}
    ,
    metafields: [
      {%- for m in metafields %}
      { namespace: {{ m.namespace|json_encode|raw }}, key: {{ m.key|json_encode|raw }}, type: {{ m.type|json_encode|raw }}, value: {{ m.value|json_encode|raw }} }{% if not loop.last %},{% endif %}
      {%- endfor %}
    ]
    {%- endif %}
  }) {
    collection {
      id
      title
      handle
      templateSuffix
      ruleSet {
        appliedDisjunctively
        rules { column relation condition }
      }
    }
    userErrors {
      field
      message
    }
  }
}
